{
  "name": "sentravail",
  "version": "1.0.0",
  "description": "SenTravail — Montre ce que tu sais faire",
  "main": "src/server.js",
  "scripts": {
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./src/styles.css -o ./public/css/app.css --minify",
    "watch:css": "tailwindcss -i ./src/styles.css -o ./public/css/app.css --watch",
    "dev": "concurrently -k -n css,web \"npm:watch:css\" \"nodemon --watch src -e js,ejs src/server.js\"",
    "start": "node src/server.js",
    "seed": "node scripts/seed.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "connect-mongo": "^6.0.0",
    "csrf-sync": "^4.2.1",
    "dotenv": "^18.0.9",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^8.7.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mongodb": "^7.8.0",
    "mongoose": "^9.11.4",
    "morgan": "^1.12.1",
    "tailwindcss": "^3.4.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  },
  "private": true,
  "engines": {
    "node": ">=20 <25"
  }
}
