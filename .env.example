# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# MySQL (Hostinger: hPanel > Databases). On Hostinger DB_HOST must be 127.0.0.1, not "localhost".
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sentravail

# Long random string (e.g. `openssl rand -hex 32`)
SESSION_SECRET=change-me

# Cloudinary (phase 2)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google AdSense (phase 6) — e.g. ca-pub-0000000000000000
ADSENSE_CLIENT_ID=
