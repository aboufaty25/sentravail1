<% const contact = helpers.whatsappLink(profile.contactNumber, `Bonjour ${profile.name}, je vous ai trouvé sur SenTravail.`); %>
<section class="flex items-center gap-4">
  <%- include('../../partials/avatar', { user: profile, size: 'h-20 w-20 text-2xl' }) %>
  <div class="min-w-0">
    <h1 class="flex items-center gap-1 truncate text-2xl font-extrabold">
      <%= profile.name %>
      <% if (profile.isVerified) { %><span title="Profil vérifié" class="text-brand-600">✔</span><% } %>
    </h1>
    <p class="text-sm text-slate-600">
      <%= profile.role === 'recruiter' ? 'Recruteur' : 'Travailleur' %><% if (profile.city) { %> · <%= helpers.cityName(profile.city) %><% if (profile.neighborhood) { %>, <%= profile.neighborhood %><% } %><% } %>
    </p>
  </div>
</section>

<% if (profile.trades.length) { %>
  <ul class="mt-4 flex flex-wrap gap-2">
    <% profile.trades.forEach(function (t) { %><li class="chip"><%= helpers.tradeLabel(t) %></li><% }) %>
  </ul>
<% } %>

<% if (profile.bio) { %>
  <p class="mt-4 whitespace-pre-line text-slate-700"><%= profile.bio %></p>
<% } %>

<div class="mt-6 grid gap-3">
  <% if (isOwner) { %>
    <a href="/profil/modifier" class="btn-outline">Modifier mon profil</a>
  <% } else { %>
    <a href="<%= contact %>" class="btn-whatsapp" target="_blank" rel="noopener nofollow">
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.4-.7-2.8-1.1-4.6-4-4.8-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .5l-.3.5-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.3.1.5.1.6-.1l.9-1c.2-.3.4-.2.6-.1l2 .9c.3.2.5.2.5.4.1.1.1.7-.1 1.3z"/></svg>
      Contacter sur WhatsApp
    </a>
  <% } %>
</div>

<section class="mt-8">
  <h2 class="mb-3 text-lg font-bold">Preuves de travail</h2>
  <p class="card text-center text-sm text-slate-500">Aucune publication pour le moment.</p>
</section>
