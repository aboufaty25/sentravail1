<%
  const profileHref = currentUser ? `/@${currentUser.id}` : '/connexion';
  const items = [
    { href: '/', label: 'Accueil', icon: '<path d="M3 11l9-8 9 8v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>', active: path === '/' },
    { href: profileHref, label: 'Profil', icon: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/>', active: path === profileHref || path.startsWith('/profil') || path === '/connexion' || path === '/inscription' },
  ];
%>
<nav class="fixed inset-x-0 bottom-0 z-30 border-t border-slate-200 bg-white pb-[env(safe-area-inset-bottom)]" aria-label="Navigation principale">
  <ul class="mx-auto flex h-16 max-w-xl items-stretch justify-around">
    <% items.forEach(function (it) { %>
      <li class="flex-1">
        <a href="<%= it.href %>" class="flex h-full flex-col items-center justify-center gap-0.5 text-xs <%= it.active ? 'text-brand-700 font-semibold' : 'text-slate-500' %>" <%= it.active ? 'aria-current=page' : '' %>>
          <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- it.icon %></svg>
          <%= it.label %>
        </a>
      </li>
    <% }) %>
  </ul>
</nav>
