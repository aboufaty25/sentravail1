<header class="sticky top-0 z-30 border-b border-slate-200 bg-white/95 backdrop-blur">
  <div class="mx-auto flex h-14 max-w-xl items-center justify-between px-4">
    <a href="/" class="flex items-center gap-2 text-lg font-extrabold tracking-tight">
      <span class="grid h-8 w-8 place-items-center rounded-lg bg-brand-600 text-white">S</span>
      <span>Sen<span class="text-brand-600">Travail</span></span>
    </a>
    <% if (currentUser) { %>
      <form method="post" action="/deconnexion">
        <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
        <button class="text-sm font-medium text-slate-600 hover:text-slate-900">Déconnexion</button>
      </form>
    <% } else { %>
      <a href="/connexion" class="text-sm font-semibold text-brand-700">Connexion</a>
    <% } %>
  </div>
</header>
