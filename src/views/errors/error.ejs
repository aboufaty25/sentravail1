<section class="py-16 text-center">
  <p class="text-5xl">⚠️</p>
  <h1 class="mt-4 text-2xl font-extrabold"><%= title %></h1>
  <p class="mt-2 text-slate-600"><%= message %></p>
  <a href="/" class="btn-primary mt-6">Retour à l'accueil</a>
  <% if (locals.stack) { %><pre class="mt-8 overflow-x-auto rounded-xl bg-slate-900 p-4 text-left text-xs text-slate-100"><%= stack %></pre><% } %>
</section>
